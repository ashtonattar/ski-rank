rules_version = '2';

// Firestore security rules for Slope Battles (skirank-b3b70).
// NOT auto-deployed from this repo — paste into Firebase Console >
// Firestore Database > Rules, or deploy via `firebase deploy --only firestore:rules`
// if you set up the Firebase CLI locally.
//
// Requires index.html's doLogin()/doSignup() to keep the Firebase Auth session
// alive (no more signOut() right after authenticating) — otherwise request.auth
// is always null here and every isAdmin()/isSignedIn() check below fails closed,
// breaking the app. That change has already been made in index.html.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Keep in sync with ADMIN_EMAILS in index.html.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ashtonattar@gmail.com';
    }

    // True if the caller IS player `pid`. Player ids are not auth uids in
    // general (index.html:4898, playerId = firebaseUid || uid()): a native
    // signup's player id equals its auth uid, but a legacy account keeps its
    // old random id and is linked via players/{pid}.firebaseUid, which only
    // the migration or an admin can set (see players/ below). Comparing
    // request.auth.uid to a player id directly rejects legacy accounts,
    // including the two most active real ones (rollout step 6a finding 1).
    // Same resolution as functions/lib/identity.js.
    function callerIsPlayer(pid) {
      return isSignedIn() && pid is string && pid != '' &&
        (request.auth.uid == pid ||
         (exists(/databases/$(database)/documents/players/$(pid)) &&
          get(/databases/$(database)/documents/players/$(pid)).data.get('firebaseUid', null) == request.auth.uid));
    }

    // ── state/global ──────────────────────────────────────────────────────
    // Almost everything lives in this one document (players, games, chat,
    // reports, tournaments, etc.), written via targeted arrayUnion updates
    // or a debounced merge:true save() from any signed-in user. Firestore
    // rules can't cheaply distinguish "which field changed" inside one big
    // document, so this can't fully replicate per-field admin-only checks
    // (e.g. "only an admin may flip a report's status") without splitting
    // admin-controlled data into its own collection — a bigger app change.
    //
    // What this DOES enforce: only signed-in users can write at all (closes
    // fully anonymous read/write), and it blocks the specific destructive
    // shape the admin "Wipe Game Data" / "Wipe Everything" tools produce
    // (collapsing a non-empty players/games list down to empty) unless the
    // caller is the admin account.
    match /state/global {
      allow read: if true; // public leaderboard/preview, no PII beyond what's shown

      // Block a non-admin from wiping player/game data down to nothing.
      function isDestructiveWipe() {
        return resource != null &&
          ( (resource.data.players.size() > 0 && request.resource.data.players.size() == 0) ||
            (resource.data.games.size()   > 0 && request.resource.data.games.size()   == 0) );
      }

      // A non-admin may only ever *append* their own report (submitReport()
      // uses arrayUnion, so old entries are never touched by that call) —
      // this stops a tampered client from filing a report that impersonates
      // someone else via a forged reporterId/reporterName. Resolving or
      // deleting an existing report (same-size or shrinking array) is
      // admin-only, enforced by falling through to isAdmin() below.
      function isValidReportsChange() {
        let oldReports = (resource != null && 'reports' in resource.data) ? resource.data.reports : [];
        let newReports = ('reports' in request.resource.data) ? request.resource.data.reports : [];
        return newReports == oldReports ||
          ( newReports.size() == oldReports.size() + 1 &&
            newReports[newReports.size()-1].reporterId == request.auth.uid );
      }

      // KNOWN GAP (tracked, not fixed by this rule): a non-admin's write can
      // still set THEIR OWN player entry's rating/wins/losses to any value —
      // ratings are computed client-side in commitGame() and merged in via
      // save() with no server-side recompute. Firestore rules can't validate
      // that cheaply here because `players`/`games` are plain arrays (not
      // maps keyed by uid), so there's no way to look up "the caller's own
      // entry" or diff a single field within one array element without a
      // per-element loop, which this rules language doesn't support. Closing
      // that gap for real requires either (a) a Cloud Function that computes
      // ratings server-side from a submitted match result, with client writes
      // to rating/wins/losses blocked here, or (b) migrating `players` to a
      // uid-keyed map/subcollection so per-field ownership is checkable.
      //
      // What CAN be enforced cheaply on arrays — and IS, below — is a bound
      // on how many player/game records a single write touches at all. That
      // stops a compromised or scripted client from bulk-rewriting the whole
      // leaderboard (e.g. setting 50 accounts to rating 3000) in one shot.
      // It does NOT stop a user quietly inflating their own single entry;
      // that's the gap above.
      function playersChangeCount() {
        let oldP = (resource != null && 'players' in resource.data) ? resource.data.players : [];
        let newP = ('players' in request.resource.data) ? request.resource.data.players : [];
        return oldP.toSet().difference(newP.toSet()).size() + newP.toSet().difference(oldP.toSet()).size();
      }

      function gamesChangeCount() {
        let oldG = (resource != null && 'games' in resource.data) ? resource.data.games : [];
        let newG = ('games' in request.resource.data) ? request.resource.data.games : [];
        return oldG.toSet().difference(newG.toSet()).size() + newG.toSet().difference(oldG.toSet()).size();
      }

      // Each changed array element counts twice (its old value removed +
      // its new value added), so a normal 1v1 game commit — 2 player entries
      // changed — already sums to 4. save() writes the WHOLE players/games
      // array on every debounced save (not a targeted diff), so any other
      // signed-in user's write that landed between this client's last fetch
      // and now shows up here too — each such stale entry adds another 2.
      // Bounds need real headroom for that organic staleness under normal
      // concurrent usage, while still catching the actual abuse case this
      // guards against (bulk-rewriting dozens of accounts in one shot, e.g.
      // 50 accounts -> 100 on this metric).
      allow write: if isAdmin() || (isSignedIn() && !isDestructiveWipe() && isValidReportsChange()
        && playersChangeCount() <= 20 && gamesChangeCount() <= 10);
    }

    // ── users/{uid} ────────────────────────────────────────────────────────
    // Doc id is the Firebase Auth UID for accounts created normally. Legacy
    // accounts (no Firebase Auth, rare fallback per PROJECT_STATUS.md) won't
    // have a matching request.auth.uid and will be unable to write under
    // these rules until they migrate on next successful login.
    match /users/{uid} {
      allow read: if true; // login-by-email lookup, public rider profiles
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ── usersPrivate/{uid} ────────────────────────────────────────────────
    // Holds PII that must NOT be exposed by users/{uid}'s public read rule
    // (currently just birthYear, collected for the signup age gate).
    match /usersPrivate/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ── avatars/{uid} ──────────────────────────────────────────────────────
    match /avatars/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ── liveGames/{gameId} ─────────────────────────────────────────────────
    // Only the two players and the optional judge may write to their own
    // match; anyone signed in may create one (gameId is derived from the
    // invite that started it, not user-chosen).
    match /liveGames/{gameId} {
      allow read: if true;
      allow create: if isSignedIn();
      // callerIsPlayer(), not auth.uid == p1/p2/judgeId: those hold PLAYER
      // ids, so a legacy participant (player id != auth uid, e.g. mptze2pp/
      // mptzm7c0) had every saveLiveGame() update denied. Confirmed by the
      // step-6a emulator probe, fixed 2026-09-25. .get() because older docs
      // may lack judgeId, and callerIsPlayer() rejects null/''.
      allow update: if isAdmin() ||
        callerIsPlayer(resource.data.get('p1', null)) ||
        callerIsPlayer(resource.data.get('p2', null)) ||
        callerIsPlayer(resource.data.get('judgeId', null));
      allow delete: if isAdmin(); // only the "Wipe Game Data" admin tool deletes these

      // Rollout step 6a forgery gate. submitMatchResult only records a live
      // result once BOTH players have a join doc here. The doc id is the
      // creator's own auth uid and nothing else can be written, so a join is
      // proof that account showed up. An outsider can create a liveGames doc
      // naming a victim, but can't create the victim's join. Kept as a
      // subcollection, not a field on the game doc, because saveLiveGame()
      // overwrites the whole doc from each client's local copy, and a stale
      // copy would clobber a join map.
      match /joins/{authUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == authUid &&
          request.resource.data.keys().hasOnly(['joinedAt']);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ── players/{playerId}, games/{gameId}, messages/{messageId}, ──────────
    // ── friendRequests/{requestId}  ─────────────────────────────────────────
    // Backend Migration Plan, sequenced rollout step 1 (see
    // "01 Refinements/(C) Backend Migration Plan - Verified 2026-09-16.md" in
    // the Obsidian vault). These four collections are the migration target for
    // players/games/messages/friendRequests currently living as arrays on
    // state/global. Nothing reads or writes them yet — no client code path
    // touches these collections until the dual-write step (rollout step 6) —
    // so shipping the rules alone here is safe.

    match /players/{playerId} {
      // Doc id is playerId = firebaseUid || uid() (index.html:4898): a
      // Firebase-Auth signup's doc id equals request.auth.uid; a legacy/guest
      // account's doc id is an unrelated random uid() with no auth uid match
      // at all. DECISION (Plan Pass 2 finding #4, option a): mirror firebaseUid
      // onto this doc so a migrated legacy account can still self-edit via
      // resource.data.firebaseUid, instead of accepting that lockout. Seeded
      // demo players (Alice/Bob/Judge — PROJECT_STATUS.md) have no auth
      // identity at all; they're admin-only for writes — isAdmin() is an
      // unconditional bypass on BOTH create and update below (not just
      // update), so an admin can actually seed/edit them with a real rating.
      //
      // KNOWN DEPENDENCY, not previously written down anywhere: this
      // firebaseUid-mirroring decision only works if the migration script
      // (rollout step 3/4) populates it. Verified directly (index.html
      // grep): `firebaseUid` is written in exactly two places — signup
      // (~4907) and legacy-login migration (~5043) — and BOTH write only to
      // `users/{uid}`, never to a `players` array entry or doc. It is NOT
      // present on `state/global.players` elements today. So the migration
      // script can't just copy the field across; for each player it must
      // separately look up that id's `users/{id}.firebaseUid` (if any) and
      // mirror it onto the new `players/{id}` doc at create time. A legacy
      // account whose `users` doc has no firebaseUid yet is correctly locked
      // out of self-editing post-migration (see the "no firebaseUid on doc"
      // case below) — that's the intended fallback, not a bug.
      //
      // firebaseUid is authorization-bearing (isOwner()/claimsOwnFirebaseUid()
      // below both trust it), so a non-admin must NEVER be able to touch it
      // via update — not to change it, and not to add it where absent either.
      // The obvious-looking alternative — "allow ADDING it via update when
      // currently absent, as long as the caller claims their own real uid" —
      // was tried and rejected: it would let ANY signed-in stranger claim
      // ownership of ANY not-yet-linked legacy player's doc outright (no
      // prior relationship to that doc required at all), which is a strictly
      // worse hole than the one this closes. So there is currently NO safe
      // client-side path to attach firebaseUid to an already-existing
      // players/{id} doc after the fact — only at create (claimsOwnFirebaseUid()
      // below, whose blast radius is bounded because the real migration
      // script's set() overwrites a squatted doc outright) or via isAdmin().
      // OPEN ITEM for a later rollout step: mirroring firebaseUid onto an
      // existing doc the first time a legacy account links Firebase Auth
      // (index.html:~5040, finishMigration() — today only writes users/{uid})
      // needs a Cloud Function that verifies the caller's identity server-
      // side and writes via the Admin SDK, not a bare client update — the
      // same reasoning that pushed rating/wins/etc. server-side applies here
      // too: an identity-bearing field can't be safely self-certified by an
      // untrusted client through rules alone.
      allow read: if true; // public leaderboard/profile data, same as today

      function isOwner() {
        return isSignedIn() &&
          (request.auth.uid == playerId ||
           request.auth.uid == resource.data.firebaseUid);
      }

      function touchesFirebaseUid() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['firebaseUid']);
      }

      // Full stop: no non-admin update may touch this field at all, whether
      // adding, changing, or clearing it.
      function firebaseUidWriteIsValid() {
        return !touchesFirebaseUid();
      }

      // logStrikes/badges added in rollout step 6a: both are now owned by the
      // Cloud Functions, and a client-writable logStrikes let a player reset
      // their own strikes to dodge the 3-strike penalty.
      //
      // rating/wins/losses/gamesPlayed/peakRating are locked to server-only
      // writes — submitMatchResult()/applyStrikePenalty() (Cloud Functions)
      // write via the Admin SDK, which bypasses these rules entirely, so
      // blocking these fields for every client write here (including the
      // doc's own owner) is what actually closes the rating-forgery gap this
      // migration exists for (Plan Pass 1 finding #1 / Pass 2 finding #2).
      function touchesLockedFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['rating', 'wins', 'losses', 'gamesPlayed', 'peakRating', 'logStrikes', 'badges']);
      }

      function lockedFieldsAtDefault() {
        return (!('rating' in request.resource.data)      || request.resource.data.rating == 400) &&
          (!('wins' in request.resource.data)         || request.resource.data.wins == 0) &&
          (!('losses' in request.resource.data)       || request.resource.data.losses == 0) &&
          (!('gamesPlayed' in request.resource.data)  || request.resource.data.gamesPlayed == 0) &&
          (!('peakRating' in request.resource.data)   || request.resource.data.peakRating == 0) &&
          (!('logStrikes' in request.resource.data)   || request.resource.data.logStrikes == 0) &&
          (!('badges' in request.resource.data)       || request.resource.data.badges == []);
      }

      // Legacy self-heal create: myMissingRecord()/the _healPlayerDone heal
      // (index.html:4303/4310) re-create a signed-in user's own players/{id}
      // doc if it's ever found missing. For a normal Firebase-Auth account
      // request.auth.uid == playerId already covers this. For a MIGRATED
      // legacy account, playerId is still the old random uid() — there's no
      // resource yet to read firebaseUid off (this is a create), so the only
      // available proof of ownership is the create itself asserting
      // firebaseUid == the caller's own real uid. This can't verify the
      // *playerId* is genuinely theirs (rules have no way to check that on a
      // brand-new doc) — someone could pre-create a stray players/{someId}
      // doc claiming their own firebaseUid. Blast radius is bounded and
      // self-correcting: locked fields still can't be seeded above default,
      // and if that id later belongs to a real migrated legacy player, the
      // migration script's own set() (Admin SDK, bypasses rules) overwrites
      // it outright — this is not a merge, so a squatted doc doesn't survive
      // the real migration write.
      function claimsOwnFirebaseUid() {
        return 'firebaseUid' in request.resource.data &&
          request.resource.data.firebaseUid == request.auth.uid;
      }

      allow create: if isAdmin() ||
        (isSignedIn() &&
         (request.auth.uid == playerId || claimsOwnFirebaseUid()) &&
         lockedFieldsAtDefault());

      allow update: if isAdmin() || (isOwner() && !touchesLockedFields() && firebaseUidWriteIsValid());

      allow delete: if isAdmin(); // bulk-delete carve-out for the admin wipe tool (Plan Pass 1 finding #2)
    }

    match /games/{gameId} {
      // Written exclusively by submitMatchResult() (Cloud Function, Admin SDK
      // — bypasses these rules). No client path creates or edits a game doc
      // directly at any point in this migration; only the admin wipe tool
      // needs a client-side delete path (Plan Pass 1 finding #2).
      allow read: if true; // public match history, same as state/global today
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      // Participant-only. state/global's `allow read: if true` currently
      // exposes every private DM to any unauthenticated request (Plan Pass 1
      // finding #3) — this collection is what actually closes that hole.
      //
      // READ-CUTOVER (rollout step 7) SHAPE, not yet written into the plan
      // doc itself: because reads here are participant-scoped, a bare
      // onSnapshot(collection('messages')) is rejected outright — Firestore
      // rejects a collection-wide listener/query unless it can prove every
      // possible result satisfies the rule, which it can't for an
      // unfiltered query against a per-doc fromId/toId check. Step 7 must
      // replace the single `state/global` listener with TWO scoped queries
      // per collection — where('fromId','==',me) and where('toId','==',me)
      // — merged client-side into S.messages, same shape for friendRequests
      // below. This is more work than "point the listener at the new
      // collection" as step 7 currently reads; the participant-only rule
      // itself is correct and is the whole point of closing the finding #3
      // hole, so the fix belongs in the client listener code, not here.
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.fromId ||
         request.auth.uid == resource.data.toId ||
         isAdmin());
      // callerIsPlayer(), not auth.uid == fromId: fromId is the sender's
      // player id, which isn't their auth uid for legacy accounts (step 6a).
      allow create: if callerIsPlayer(request.resource.data.fromId) &&
        request.resource.data.toId is string && request.resource.data.toId != '';
      allow update: if false; // messages are immutable once sent
      allow delete: if isAdmin(); // bulk-delete carve-out for the admin wipe tool
    }

    match /friendRequests/{requestId} {
      // Participant-only, same privacy rationale as messages/ above — and
      // the same step-7 consequence: scoped where('fromId','==',me) +
      // where('toId','==',me) queries, merged client-side, not a bare
      // collection listener (see the messages/ comment above for why).
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.fromId ||
         request.auth.uid == resource.data.toId ||
         isAdmin());
      allow create: if callerIsPlayer(request.resource.data.fromId) &&
        request.resource.data.status == 'pending';
      // Only the recipient may accept/decline, only while still pending, and
      // only the status field may change (mirrors acceptFriendRequest()/
      // declineFriendRequest(), index.html:8997/9017).
      allow update: if callerIsPlayer(resource.data.toId) &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['accepted', 'declined'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // cancelFriendRequest() (index.html:8982) deletes the sender's own
      // still-pending request. unfriend() (index.html:9031) deletes a settled
      // request from EITHER side, so once it's no longer pending both parties
      // may delete it (rollout step 6a finding 2).
      allow delete: if isAdmin() ||
        (resource.data.status == 'pending' && callerIsPlayer(resource.data.fromId)) ||
        (resource.data.status != 'pending' &&
          (callerIsPlayer(resource.data.fromId) || callerIsPlayer(resource.data.toId)));
    }

    // ── pendingResults/{pendingId} ────────────────────────────────────────
    // Rollout step 6a forgery gate. The server-trusted twin of a
    // state/global.pending entry, written only by the reportPendingResult
    // Cloud Function (Admin SDK) with a server-resolved reporter. The
    // functions authorize against this, never against state/global.pending.
    // Read rule is written for single-doc gets; a list query would need
    // a filter on reporterId/opponentId.
    match /pendingResults/{pendingId} {
      allow read: if isAdmin() ||
        callerIsPlayer(resource.data.reporterId) || callerIsPlayer(resource.data.opponentId);
      allow write: if false;
    }

    // ── resolutions/{key} ─────────────────────────────────────────────────
    // Cloud-Function-only record that a live game (live_<liveGameId>) or
    // pending entry (pending_<pendingId>) has been settled — the idempotency
    // guard for submitMatchResult/applyStrikePenalty (functions/lib). Written
    // only via the Admin SDK, which bypasses these rules; no client may write
    // it, or a participant could clear it and re-apply a result.
    match /resolutions/{key} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
