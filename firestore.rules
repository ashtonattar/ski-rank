rules_version = '2';

// Firestore security rules for Slope Battles (skirank-b3b70).
// NOT auto-deployed from this repo — paste into Firebase Console >
// Firestore Database > Rules, or deploy via `firebase deploy --only firestore:rules`
// if you set up the Firebase CLI locally.
//
// Requires index.html's doLogin()/doSignup() to keep the Firebase Auth session
// alive (no more signOut() right after authenticating) — otherwise request.auth
// is always null here and every isAdmin()/isSignedIn() check below fails closed,
// breaking the app. That change has already been made in index.html.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Keep in sync with ADMIN_EMAILS in index.html.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ashtonattar@gmail.com';
    }

    // ── state/global ──────────────────────────────────────────────────────
    // Almost everything lives in this one document (players, games, chat,
    // reports, tournaments, etc.), written via targeted arrayUnion updates
    // or a debounced merge:true save() from any signed-in user. Firestore
    // rules can't cheaply distinguish "which field changed" inside one big
    // document, so this can't fully replicate per-field admin-only checks
    // (e.g. "only an admin may flip a report's status") without splitting
    // admin-controlled data into its own collection — a bigger app change.
    //
    // What this DOES enforce: only signed-in users can write at all (closes
    // fully anonymous read/write), and it blocks the specific destructive
    // shape the admin "Wipe Game Data" / "Wipe Everything" tools produce
    // (collapsing a non-empty players/games list down to empty) unless the
    // caller is the admin account.
    match /state/global {
      allow read: if true; // public leaderboard/preview, no PII beyond what's shown

      // Block a non-admin from wiping player/game data down to nothing.
      function isDestructiveWipe() {
        return resource != null &&
          ( (resource.data.players.size() > 0 && request.resource.data.players.size() == 0) ||
            (resource.data.games.size()   > 0 && request.resource.data.games.size()   == 0) );
      }

      // A non-admin may only ever *append* their own report (submitReport()
      // uses arrayUnion, so old entries are never touched by that call) —
      // this stops a tampered client from filing a report that impersonates
      // someone else via a forged reporterId/reporterName. Resolving or
      // deleting an existing report (same-size or shrinking array) is
      // admin-only, enforced by falling through to isAdmin() below.
      function isValidReportsChange() {
        let oldReports = (resource != null && 'reports' in resource.data) ? resource.data.reports : [];
        let newReports = ('reports' in request.resource.data) ? request.resource.data.reports : [];
        return newReports == oldReports ||
          ( newReports.size() == oldReports.size() + 1 &&
            newReports[newReports.size()-1].reporterId == request.auth.uid );
      }

      // KNOWN GAP (tracked, not fixed by this rule): a non-admin's write can
      // still set THEIR OWN player entry's rating/wins/losses to any value —
      // ratings are computed client-side in commitGame() and merged in via
      // save() with no server-side recompute. Firestore rules can't validate
      // that cheaply here because `players`/`games` are plain arrays (not
      // maps keyed by uid), so there's no way to look up "the caller's own
      // entry" or diff a single field within one array element without a
      // per-element loop, which this rules language doesn't support. Closing
      // that gap for real requires either (a) a Cloud Function that computes
      // ratings server-side from a submitted match result, with client writes
      // to rating/wins/losses blocked here, or (b) migrating `players` to a
      // uid-keyed map/subcollection so per-field ownership is checkable.
      //
      // What CAN be enforced cheaply on arrays — and IS, below — is a bound
      // on how many player/game records a single write touches at all. That
      // stops a compromised or scripted client from bulk-rewriting the whole
      // leaderboard (e.g. setting 50 accounts to rating 3000) in one shot.
      // It does NOT stop a user quietly inflating their own single entry;
      // that's the gap above.
      function playersChangeCount() {
        let oldP = (resource != null && 'players' in resource.data) ? resource.data.players : [];
        let newP = ('players' in request.resource.data) ? request.resource.data.players : [];
        return oldP.toSet().difference(newP.toSet()).size() + newP.toSet().difference(oldP.toSet()).size();
      }

      function gamesChangeCount() {
        let oldG = (resource != null && 'games' in resource.data) ? resource.data.games : [];
        let newG = ('games' in request.resource.data) ? request.resource.data.games : [];
        return oldG.toSet().difference(newG.toSet()).size() + newG.toSet().difference(oldG.toSet()).size();
      }

      // Each changed array element counts twice (its old value removed +
      // its new value added), so a normal 1v1 game commit — 2 player entries
      // changed — already sums to 4. save() writes the WHOLE players/games
      // array on every debounced save (not a targeted diff), so any other
      // signed-in user's write that landed between this client's last fetch
      // and now shows up here too — each such stale entry adds another 2.
      // Bounds need real headroom for that organic staleness under normal
      // concurrent usage, while still catching the actual abuse case this
      // guards against (bulk-rewriting dozens of accounts in one shot, e.g.
      // 50 accounts -> 100 on this metric).
      allow write: if isAdmin() || (isSignedIn() && !isDestructiveWipe() && isValidReportsChange()
        && playersChangeCount() <= 20 && gamesChangeCount() <= 10);
    }

    // ── users/{uid} ────────────────────────────────────────────────────────
    // Doc id is the Firebase Auth UID for accounts created normally. Legacy
    // accounts (no Firebase Auth, rare fallback per PROJECT_STATUS.md) won't
    // have a matching request.auth.uid and will be unable to write under
    // these rules until they migrate on next successful login.
    match /users/{uid} {
      allow read: if true; // login-by-email lookup, public rider profiles
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ── usersPrivate/{uid} ────────────────────────────────────────────────
    // Holds PII that must NOT be exposed by users/{uid}'s public read rule
    // (currently just birthYear, collected for the signup age gate).
    match /usersPrivate/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ── avatars/{uid} ──────────────────────────────────────────────────────
    match /avatars/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ── liveGames/{gameId} ─────────────────────────────────────────────────
    // Only the two players and the optional judge may write to their own
    // match; anyone signed in may create one (gameId is derived from the
    // invite that started it, not user-chosen).
    match /liveGames/{gameId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.p1 ||
         request.auth.uid == resource.data.p2 ||
         request.auth.uid == resource.data.judgeId ||
         isAdmin());
      allow delete: if isAdmin(); // only the "Wipe Game Data" admin tool deletes these
    }
  }
}
